{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译（gcc）",
            "type": "process",
            "command": "C:\\Users\\soryu\\Downloads\\x86_64-8.1.0-release-posix-seh-rt_v6-rev0\\mingw64\\bin\\gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "-finput-charset=UTF-8",
                "-fexec-charset=GBK",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "▶ 编译并运行",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "编译（gcc）",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true,
                "echo": true,
                "showReuseMessage": false
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译后在集成终端运行，不弹外部窗口"
        }
    ]
}
